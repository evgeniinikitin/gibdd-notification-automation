# Application
APP_ENV=development
APP_NAME=Buscript
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:8000
# Browser requests stay on the Buscript web origin. Next.js forwards them to
# this Docker-internal API address, avoiding host VPN routing and CORS.
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://api:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Database and queue
POSTGRES_DB=buscript
POSTGRES_USER=buscript
POSTGRES_PASSWORD=
DATABASE_URL=sqlite+aiosqlite:///./storage/buscript.db
REDIS_URL=redis://redis:6379/0

# Internal local administrator (not a customer company)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_TENANT_NAME=Buscript Administration
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=

# Optional demo fixture; disabled during normal startup
DEMO_SEED_ENABLED=false
SEED_TENANT_NAME=Компания Test
SEED_USER_EMAIL=demo@example.test
SEED_USER_PASSWORD=
SEED_NOTIFICATION_BALANCE=25

# Files
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=50

# Gemini handles attached PDFs natively in one multimodal request.
LLM_PROVIDER=gemini
# For explicit local UI smoke tests without network only:
# LLM_PROVIDER=mock
GEMINI_API_KEY=
# Optional reserve keys. Buscript rotates to the next key automatically when
# Google reports an exhausted quota, rate limit, invalid key, or 5xx error.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional proxy used only by Gemini. When empty, Gemini connects directly.
GEMINI_PROXY_URL=

# OpenRouter is a fallback provider and remains the captcha provider.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_CAPTCHA_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Buscript
# Optional proxy used only by OpenRouter; it is never inherited by GIBDD Chromium.
# Examples: http://user:password@proxy.example:8080
#           socks5://user:password@proxy.example:1080
OPENROUTER_PROXY_URL=
LLM_MAX_DOCUMENT_CONTEXT_CHARS=180000
LLM_MAX_CHARS_PER_DOCUMENT=80000
LLM_MAX_RECENT_MESSAGE_CHARS=30000
LLM_WORKFLOW_TIMEOUT_SECONDS=120

# GIBDD browser worker
GIBDD_BASE_URL=https://xn--80aebkobnwfcnsfk1e0h.xn--p1ai/transportation
GIBDD_LIVE_SUBMISSION=false
# Docker/browser-worker is headless by default. Set true only for an explicit
# local host run with a visible desktop session.
GIBDD_HEADFUL=false
# Forces Chromium to ignore HTTP_PROXY/HTTPS_PROXY/ALL_PROXY. A full-device VPN
# still requires split tunneling for автобус.гибдд.рф or browser-worker.
GIBDD_ROUTE_DIRECT=true
CAPTCHA_MODE=llm_ocr
CAPTCHA_MAX_ATTEMPTS=5
CAPTCHA_CONFIDENCE_THRESHOLD=0.80
